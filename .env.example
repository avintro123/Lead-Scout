# LeadScout — Environment Variables
# Copy this file to .env.local and populate with your credentials

# ==============================================================================
# 1. Google Gemini AI (Required for live deep research & AI copywriting)
# ==============================================================================
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ==============================================================================
# 2. Email Delivery Engine (Optional — for live inbox test dispatch)
# ==============================================================================
# If omitted, LeadScout operates in zero-config Sandbox Simulation mode.
# Get a free key at: https://resend.com/api-keys
RESEND_API_KEY=

# ==============================================================================
# 3. Supabase Cloud Database (Optional — for real-time cloud synchronization)
# ==============================================================================
# If omitted or paused, LeadScout automatically uses offline-first LocalStorage.
# Create a free project at: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Supabase service role key for administrative server-side operations
# SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 4. Security & Admin Authentication (Optional)
# ==============================================================================
# Custom password for admin features. Defaults to "scout-admin-2026" if omitted.
ADMIN_PASSPHRASE=

# Optional: Secret salt for signing admin session cookies
AUTH_SECRET=
